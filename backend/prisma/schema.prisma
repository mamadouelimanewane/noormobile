generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  role          String   // "passager", "chauffeur", "admin"
  rating        Float    @default(5.0)
  ratingCount   Int      @default(0)
  avatarColor   String
  walletBalance Float    @default(0.0)
  
  // Passenger Specifics
  savedHome     String?
  savedWork     String?
  emergencyName String?
  emergencyPhone String?

  // Referral System
  referralCode  String?  @unique
  referredById  String?

  // Push Notifications
  fcmToken      String?

  createdAt     DateTime @default(now())

  // Driver specifics
  isOnline      Boolean  @default(false)
  accountStatus String   @default("APPROVED") // "APPROVED", "PENDING", "REJECTED"
  vehicle       Vehicle?
  driverLevel   String   @default("BRONZE") // BRONZE, SILVER, GOLD
  completedRides Int     @default(0)
  documents     DriverDocument[]
  
  // Relations
  requestsAsPassenger ServiceRequest[] @relation("PassengerRequests")
  requestsAsDriver    ServiceRequest[] @relation("DriverRequests")
  offers              Offer[]
  transactions        Transaction[]
  loans               LoanRequest[]
  messages            ChatMessage[]
  tickets             SupportTicket[]
  ticketMessages      TicketMessage[]
  
  // Intercity Carpool Relations
  carpoolTrips        CarpoolTrip[]
  carpoolBookings     CarpoolBooking[]
}

model Vehicle {
  id       String @id @default(cuid())
  driverId String @unique
  marque   String
  modele   String
  plaque   String
  couleur  String
  category String @default("Standard") // "Standard", "Confort", "Moto"
  driver   User   @relation(fields: [driverId], references: [id])
}

model ServiceRequest {
  id              String   @id @default(cuid())
  type            String   // "ride", "delivery", "intercity"
  passengerId     String
  passenger       User     @relation("PassengerRequests", fields: [passengerId], references: [id])
  driverId        String?
  driver          User?    @relation("DriverRequests", fields: [driverId], references: [id])
  status          String   // "recherche", "negociation", "attribue", "en_cours", "termine", "annule"
  proposedPrice   Float
  pickupLat       Float
  pickupLng       Float
  pickupLabel     String
  dropoffLat      Float
  dropoffLng      Float
  dropoffLabel    String
  driverPosLat    Float?
  driverPosLng    Float?
  
  ratingPassenger Float?
  ratingDriver    Float?

  // For Delivery
  packageDesc     String?
  packageSize     String?
  destName        String?
  destPhone       String?

  // For Intercity
  villeDepart     String?
  villeArrivee    String?
  dateDepart      String?
  places          Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offers          Offer[]
  messages        ChatMessage[]
}

model Offer {
  id           String   @id @default(cuid())
  requestId    String
  request      ServiceRequest @relation(fields: [requestId], references: [id])
  driverId     String
  driver       User     @relation(fields: [driverId], references: [id])
  price        Float
  etaMin       Int
  status       String   // "en_attente", "acceptee", "refusee"
  createdAt    DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // "topup", "cashout", "payment", "commission", "loan"
  amount      Float
  method      String   // "wave", "orange_money", "cash"
  status      String   // "pending", "completed", "failed"
  reference   String
  description String
  createdAt   DateTime @default(now())
}

model LoanRequest {
  id          String   @id @default(cuid())
  driverId    String
  driver      User     @relation(fields: [driverId], references: [id])
  montant     Float
  motif       String
  dureeMois   Int
  mensualite  Float
  montantRembourse Float @default(0.0)
  status      String   // "en_attente", "approuve", "refuse", "rembourse", "en_cours"
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id          String   @id @default(cuid())
  requestId   String
  request     ServiceRequest @relation(fields: [requestId], references: [id])
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  text        String
  createdAt   DateTime @default(now())
}

model PlatformSettings {
  id                   String @id @default("default")
  commissionRate       Float  @default(0.12)
  referralBonusSponsor Float  @default(1000)
  referralBonusReferee Float  @default(500)
  baseFare             Float  @default(1000)
  perKmRate            Float  @default(200)
  withdrawalFee        Float  @default(0.01)
  maxLoanAmount        Float  @default(100000)
}

model DriverDocument {
  id        String   @id @default(cuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  type      String   // "ID_CARD", "DRIVING_LICENSE", "VEHICLE_REGISTRATION"
  url       String   // URL to the uploaded file
  status    String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt DateTime @default(now())
}

model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// --- COVOITURAGE INTERURBAIN ---
model CarpoolTrip {
  id           String   @id @default(cuid())
  driverId     String
  driver       User     @relation(fields: [driverId], references: [id])
  villeDepart  String
  villeArrivee String
  dateDepart   DateTime
  prixParPlace Float
  placesTotales Int
  placesReservees Int   @default(0)
  status       String   @default("OPEN") // OPEN, FULL, COMPLETED, CANCELLED
  createdAt    DateTime @default(now())

  bookings     CarpoolBooking[]
}

model CarpoolBooking {
  id           String   @id @default(cuid())
  tripId       String
  trip         CarpoolTrip @relation(fields: [tripId], references: [id])
  passengerId  String
  passenger    User     @relation(fields: [passengerId], references: [id])
  placesBooked Int
  totalPrice   Float
  status       String   @default("CONFIRMED")
  createdAt    DateTime @default(now())
}

// --- SUPPORT CLIENT ---
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  category    String   @default("GENERAL") // RIDE, PAYMENT, ACCOUNT, GENERAL
  referenceId String?  // ID of a ride or transaction if applicable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    TicketMessage[]
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  text        String
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
